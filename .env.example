# Copy this file to .env locally (NEVER commit .env):
#   cp .env.example .env
# On Render, set these same keys in Dashboard -> your service -> Environment.

# Supabase Postgres connection (project settings -> Database -> Connection string "Direct" / pooler)
PGHOST=your-project.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.xxxxxxxxxxxxxxxxxxxx
PGPASSWORD=your-database-password
PGSSL=true

# Port Read by server (Render overrides this automatically)
PORT=3000

# Secret used to sign login tokens - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-a-long-random-string

# Email notifications (Gmail SMTP). Set EMAIL_ENABLED=true and fill these to turn on
# task assignment / completion alert emails. Leave EMAIL_ENABLED unset to keep emails off.
# EMAIL_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=your-account@gmail.com

# Public base URL used in notification email links (your Render URL, e.g. https://zita-plm.onrender.com)
# APP_URL=https://zita-plm.onrender.com